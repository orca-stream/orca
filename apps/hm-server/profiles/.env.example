# Orca'H&M server: one profile per target. Copy this file to profiles/<name>.env (never committed)
# and run with HM_PROFILE=<name> (from the repo root: HM_PROFILE=<name> pnpm dev:hm).
# Nothing has a default: every value below is only a suggestion, and the server refuses to start
# until each required one is set. Give every profile its own DB_FILE: what it records points at
# that target's library.
#
# Two ways to run it:
# - Local: Jellyfin runs on this same machine and the server writes straight into its library
#   folder. MEDIA_ROOT and JELLYFIN_MEDIA_ROOT are then the same path.
# - Server: Jellyfin runs on another machine reached over SSH. Either Bifröst deploys this server
#   there (apps/bifrost, which writes its own environment), or this one writes into that library
#   through a mount such as sshfs: MEDIA_ROOT is the mount here, JELLYFIN_MEDIA_ROOT the path there.

# --- required
# JELLYFIN_URL=http://<jellyfin-host>:8096
# Create it in Jellyfin: Dashboard > API Keys.
# JELLYFIN_API_KEY=
# Where the library lives, as this server sees it.
# MEDIA_ROOT=/path/to/library/tv
# The same folder as Jellyfin sees it (the same value when both see it at the same path).
# JELLYFIN_MEDIA_ROOT=/path/to/library/tv
# DB_FILE=./data/<name>.sqlite
# HOST=127.0.0.1
# PORT=8787

# --- optional
# Who sites such as archive.org can write to about this server's requests (goes in the User-Agent).
# CONTACT_EMAIL=
# Overrides the device id generated once and kept in the database.
# DEVICE_ID=
# Absolute path of the built panel, once there is one.
# WEB_ROOT=
# Set to true only behind HTTPS.
# SECURE_COOKIES=false
# DOWNLOAD_CONCURRENCY=2
# FFMPEG_CONCURRENCY=1
# BROWSER_CONCURRENCY=1
# Override what each extractor declares for its hosts (archive.org: 1 request a second, 1 download).
# DOWNLOADS_PER_HOST=1
# METADATA_PER_SEC=1

# --- sites described by selectors (off unless set; their players need the browser below)
# A JSON file, never committed (it names the sites): see sites.example.json next to this file.
# HM_SITES_FILE=./sites.json

# --- generic page detector (off unless enabled; needs Chromium, see the Dockerfile's WITH_CHROMIUM)
# Lets you pick "Generic page" when adding a series: a headless browser opens the address and finds
# the video it plays.
# HM_GENERIC_DETECTOR=1
# With the detector or a sites file on, these three are required (no defaults):
# HM_DETECTOR_MAX_CONCURRENT=1
# HM_DETECTOR_TIMEOUT_MS=45000
# HM_DETECTOR_SETTLE_MS=3000
# HM_DETECTOR_USER_AGENT=
# The generic detector also starts a guarded proxy on 127.0.0.1 (ephemeral port) that Chromium, ffmpeg
# and ffprobe go through; see "What the generic detector can reach" in docs/hm-server-design.md.
# Path of the Chromium to launch (the image built with WITH_CHROMIUM=1 has /usr/bin/chromium).
# Debian's Chromium is not the build Playwright 1.64.1 pins: see docs/hm-server-design.md. The server
# checks the file exists at boot and refuses to start when it does not.
# HM_CHROMIUM_PATH=/usr/bin/chromium
# Chromium in a container usually cannot create its own sandbox.
# HM_CHROMIUM_NO_SANDBOX=true

# --- tracks of streams (HLS/DASH). Languages are ISO 639-2 codes as ffprobe reports them:
# three letters, such as eng, spa, jpn (not en/es). Each series can override these in the panel.
# Unset: the best quality, every audio track and every text subtitle.
# DEFAULT_MAX_HEIGHT=1080
# DEFAULT_AUDIO_LANGS=spa,eng
# An empty value means no subtitles.
# DEFAULT_SUBTITLE_LANGS=spa,eng
# Write subtitles as files beside the video (Show S01E01.spa.srt) instead of inside the mkv.
# SUBTITLES_EXTERNAL=false
