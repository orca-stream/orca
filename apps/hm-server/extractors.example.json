{
  "site-a": {
    "reads": "page",
    "name": "Site A",
    "hosts": ["origin.test"],
    "example": "https://origin.test/anime/some-show",
    "seasonPath": "^/anime/[^/]+$",
    "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36",
    "limits": {
      "metadataPerSec": 2,
      "downloadsPerHost": 1
    },
    "title": {
      "selector": "h1"
    },
    "listing": {
      "pages": {
        "selector": "#episode-range-select option",
        "attribute": "value",
        "path": "{url}/episodes/{value}"
      },
      "episodes": {
        "selector": "a.episode-card",
        "attribute": "href"
      },
      "number": "episodio-(\\d+)"
    },
    "mirrors": {
      "selector": "button.watch-server",
      "attribute": "data-server-url"
    },
    "search": {
      "reads": "html",
      "url": "https://origin.test/directorio?q={query}&page={page}",
      "items": "article.anime-card",
      "type": {
        "selector": ".anime-card-type",
        "series": ["TV Anime", "ONA", "OVA", "Especial"]
      },
      "result": {
        "url": { "selector": "h2.anime-card-title a" },
        "title": { "selector": "h2.anime-card-title a" },
        "year": { "selector": ".anime-card-meta span" },
        "poster": { "selector": "img", "attribute": "src" }
      },
      "posterHosts": ["covers.example"]
    }
  },
  "site-b": {
    "reads": "api",
    "hosts": ["origin.test"],
    "example": "https://origin.test/series/some-show?season=1",
    "showPath": "^/series/([^/]+)/?$",
    "api": "https://origin.test/api-prefix/v1",
    "images": "https://origin.test/wp-content/uploads",
    "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36",
    "languages": ["Latino"],
    "limits": {
      "metadataPerSec": 2,
      "downloadsPerHost": 1
    },
    "search": {
      "reads": "json",
      "url": "https://origin.test/wp-api/v1/search?postType=any&postsPerPage=30&q={query}&page={page}",
      "items": "data.posts",
      "lastPage": "data.pagination.last_page",
      "type": {
        "from": "{type}",
        "series": ["tvshows", "animes"],
        "movie": ["movies"]
      },
      "result": {
        "url": {
          "series": "/series/{slug}"
        },
        "title": "{title}",
        "originalTitle": "{original_title}",
        "year": "{release_date}",
        "plot": "{overview}",
        "poster": "https://origin.test/wp-content/uploads{images.poster}"
      }
    }
  },
  "site-c": {
    "reads": "page",
    "name": "Site C",
    "hosts": ["origin.test"],
    "example": "https://origin.test/serie/some-show/",
    "seasonPath": "^/temporada/[^/]+-\\d+$",
    "title": {
      "selector": "h1.title [itemprop=name]",
      "match": "^Ver Serie (.+)$"
    },
    "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36",
    "limits": {
      "metadataPerSec": 2,
      "downloadsPerHost": 1
    },
    "listing": {
      "episodes": {
        "selector": "div.item-season-episodes > a",
        "attribute": "href"
      },
      "number": "\\d+x(\\d+)/?$"
    },
    "seasons": {
      "showPath": "^/serie/[^/]+$",
      "show": {
        "from": "^/temporada/(.+)-\\d+$",
        "to": "/serie/{1}/"
      },
      "links": {
        "selector": "p.item-season-title a",
        "attribute": "href"
      },
      "number": "-(\\d+)$"
    },
    "mirrors": {
      "selector": ".tab-video-item > ul > li[role=presentation]",
      "attribute": "data-server",
      "decode": "base64",
      "unwrap": "url"
    },
    "search": {
      "reads": "html",
      "url": "https://origin.test/?s={query}",
      "items": "div.movie-item",
      "result": {
        "url": { "selector": "a", "attribute": "href" },
        "title": { "selector": ".item-detail p" },
        "year": { "selector": "span.year" },
        "poster": { "selector": "img.poster", "attribute": "src" }
      }
    }
  },
  "site-d": {
    "reads": "season-api",
    "name": "Site D",
    "hosts": ["another.test"],
    "example": "https://another.test/anime/some-show-11111",
    "seasonPath": "^/anime/[^/]*-(\\d+)/?$",
    "api": "https://origin.test/api-prefix/v1",
    "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36",
    "tracks": ["sub", "dub"],
    "limits": {
      "metadataPerSec": 2,
      "downloadsPerHost": 1
    },
    "search": {
      "reads": "json",
      "url": "https://graphql.origin.test/",
      "body": {
        "query": "query($search:String,$page:Int,$perPage:Int){ Page(page:$page,perPage:$perPage){ pageInfo { hasNextPage } media(search:$search,type:ANIME,isAdult:false,sort:SEARCH_MATCH){ id title { romaji english native } coverImage { extraLarge large } description(asHtml:false) format seasonYear } } }",
        "variables": { "search": "{query}", "page": "{page}", "perPage": 20 }
      },
      "items": "data.Page.media",
      "nextPage": "data.Page.pageInfo.hasNextPage",
      "type": {
        "from": "{format}",
        "series": ["TV", "TV_SHORT", "ONA", "OVA", "SPECIAL"],
        "movie": ["MOVIE"]
      },
      "result": {
        "url": {
          "series": "/anime/{title.english|title.romaji|title.native|'anime':slug(60)}-{id}"
        },
        "title": "{title.english|title.romaji|title.native}",
        "originalTitle": "{title.romaji}",
        "year": "{seasonYear}",
        "plot": "{description}",
        "poster": "{coverImage.extraLarge|coverImage.large}"
      },
      "posterHosts": ["images.origin.test"]
    }
  }
}
