# Orca'H&M server: only what it needs to start. Everything else (Jellyfin, the library folder, TMDB,
# the sites, downloads) is set from the panel and kept in the database: open the panel after starting
# the server and it walks you through it.
#
# Nothing here is needed: without a .env the server listens on every address (the LAN too) on port
# 8787 and keeps its database in apps/hm-server/data/hm.sqlite. To change any of that, copy this file
# to .env (never committed) and set what differs.

# --- where it listens and keeps its database
# DB_FILE=./data/hm.sqlite
# HOST=0.0.0.0
# PORT=8787

# --- optional
# Absolute path of the built panel, once there is one.
# WEB_ROOT=
# Set to true only behind HTTPS.
# SECURE_COOKIES=false
# Overrides the device id generated once and kept in the database.
# DEVICE_ID=
