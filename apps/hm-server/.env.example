# Orca'H&M server. Copy to .env and fill in; .env is never committed.
# Everything marked required has no default: the server refuses to start without it.

# --- required
JELLYFIN_URL=http://localhost:8096
# Create it in Jellyfin: Dashboard > API Keys.
JELLYFIN_API_KEY=
# Where the library lives, as this server sees it.
MEDIA_ROOT=./media/tv
# The same folder as Jellyfin sees it (the same value when both mount it at the same path).
JELLYFIN_MEDIA_ROOT=./media/tv
DB_FILE=./data/hm.sqlite
HOST=localhost
PORT=8787

# --- optional
# Who sites such as archive.org can write to about this server's requests (goes in the User-Agent).
# CONTACT_EMAIL=
# Overrides the device id generated once and kept in the database.
# DEVICE_ID=
# Absolute path of the built panel, once there is one.
# WEB_ROOT=
# Set to true only behind HTTPS.
# SECURE_COOKIES=false
# DOWNLOAD_CONCURRENCY=2
# FFMPEG_CONCURRENCY=1
# BROWSER_CONCURRENCY=1
# IA_HOST_CONCURRENCY=1
