# Servers offered on the sign-in picker, comma-separated (addresses, with or without http://).
# Leave empty to offer only the servers this device already signed in to, plus manual entry.
# Example: VITE_JELLYFIN_SERVERS=https://jellyfin.example.com,http://media.local:8096
VITE_JELLYFIN_SERVERS=
# Older single-server form; still read, and listed first.
VITE_JELLYFIN_SERVER_URL=

# Address phones open when they scan the "sign in with your phone" QR. Leave empty to use the
# address the app was loaded from (it must not be localhost, or the phone can't reach it).
VITE_PUBLIC_URL=
