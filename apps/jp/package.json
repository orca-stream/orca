{
  "name": "@orca/jp",
  "version": "0.0.0",
  "private": true,
  "description": "A Netflix-style Jellyfin client for the browser, LG webOS and Xbox",
  "author": "selkiecode <352633863+selkiecode@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "typecheck": "tsc -b",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "android:assets": "./scripts/android-assets.sh",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "xbox:assets": "./scripts/xbox-assets.sh",
    "xbox:build": "./scripts/xbox-build.sh",
    "xbox:deploy": "./scripts/xbox-deploy.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/screen-orientation": "8.0.2",
    "@jellyfin/sdk": "1.0.0",
    "@noriginmedia/norigin-spatial-navigation-core": "4.1.2",
    "@noriginmedia/norigin-spatial-navigation-react": "3.3.0",
    "axios": "1.20.0",
    "hls.js": "1.7.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
