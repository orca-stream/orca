# Copy to .env (gitignored) and fill in. Every key below is named by a *Secret field in
# bifrost.yaml; the values live only here. Keys marked "filled by" are written for you.

# Jellyfin admin password: set before `bifrost init`.
JELLYFIN_ADMIN_PASSWORD=
# Jellyfin admin API key: filled by `bifrost init` or `bifrost migrate`.
JELLYFIN_API_KEY=
# Key H&M uses against Jellyfin ("Orca H&M"): filled by `bifrost hm up`.
ORCA_HM_JELLYFIN_API_KEY=
# E-mail for H&M's User-Agent: set by hand when hm.contactEmailSecret is configured.
HM_CONTACT_EMAIL=
# restic repository password: set before `bifrost backup` (backup section).
RESTIC_PASSWORD=
# API key of the old server: set before `bifrost migrate` (migrate section).
JELLYFIN_SOURCE_API_KEY=
