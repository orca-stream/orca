{
  "name": "@orca/hm-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Orca'H&M as a desktop app: runs the server and opens its panel",
  "homepage": "https://github.com/orca-stream/orca",
  "license": "MIT",
  "author": "selkiecode <352633863+selkiecode@users.noreply.github.com>",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.scripts.json",
    "test": "vp test run",
    "stage:server": "node scripts/stage.ts",
    "start": "pnpm build && electron . --no-sandbox",
    "dist:linux": "pnpm build && pnpm stage:server && node scripts/deb.ts && electron-builder --linux deb --publish never"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@orca/hm-contract": "workspace:*",
    "@types/node": "catalog:",
    "dbus-native": "0.16.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:",
    "x11": "4.3.3"
  },
  "desktopName": "orca-hm.desktop"
}
