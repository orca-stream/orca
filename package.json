{
  "name": "orca",
  "version": "0.0.0",
  "private": true,
  "description": "A Netflix-style Jellyfin client for the browser, LG webOS and Xbox",
  "license": "MIT",
  "author": "selkiecode <352633863+selkiecode@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/jp dev",
    "dev:hm": "pnpm --parallel --filter \"./apps/hm-*\" dev",
    "preview": "vp -C apps/jp preview",
    "check": "vp check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "prepare": "vp config",
    "android:assets": "pnpm --filter @orca/jp android:assets",
    "android:sync": "pnpm --filter @orca/jp android:sync",
    "android:apk": "pnpm --filter @orca/jp android:apk",
    "xbox:assets": "pnpm --filter @orca/jp xbox:assets",
    "xbox:build": "pnpm --filter @orca/jp xbox:build",
    "xbox:deploy": "pnpm --filter @orca/jp xbox:deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.13.3",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
